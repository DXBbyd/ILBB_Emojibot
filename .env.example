# ============================================================
#  ILBB Emoji Bot 配置模板
#  ------------------------------------------------------------
#  复制本文件为 .env 后按需修改（也可以首次启动后在「引导页 / 设置页」里改，会自动写回）。
#  · .env 已被 .gitignore 忽略，不要提交含密钥的 .env。
#  · 所有项都有内置默认值，删掉某一行 = 使用默认值。
#  · 加载顺序：系统环境变量 > .env > 代码内置默认值。
#  · 改完重启服务生效。
# ============================================================

# ==================== WebUI / Flask ====================
# 监听地址。0.0.0.0 = 允许局域网/外部访问；127.0.0.1 = 仅本机。
WEB_HOST=0.0.0.0
# 监听端口。注意：从其他设备访问需要在 Windows 防火墙放行该端口。
WEB_PORT=5000
# 调试模式（生产/日常使用保持 false）。
WEB_DEBUG=false
# 多线程处理请求（true 时慢请求不会阻塞登录与其他接口）。
WEB_THREADED=true
# 单次请求体上限（MB）。头像/上传图走 base64，默认 64。
WEB_MAX_UPLOAD_MB=64
# session 加密密钥：
#   留空 = 每次启动随机生成 → 重启后旧登录 cookie 失效，需重新登录（更安全）
#   填固定字符串 = 重启后保持登录状态
SECRET_KEY=

# 引导页里设置你自己的管理密码之前，临时使用的密码。
#   留空 = 启动时随机生成 8 位并打印到启动日志
#   填写 = 用该值作为临时密码
# 用户在引导页第 4 步（或「设置 → 修改管理密码」）设置自己的密码后，这枚临时密码作废
# 注意：设置之后密码由 api_keys.json 里的哈希决定，改这里不再影响登录；
#       日常改密码请用 WebUI「设置 → 修改管理密码」。
INIT_ADMIN_PASSWORD=

# ==================== WS 服务器（OneBot V11 / NapCat）====================
# 反向 WebSocket 监听地址。NapCat 里填 ws://<本机IP>:<WS_PORT><WS_PATH>
WS_HOST=0.0.0.0
WS_PORT=6700
# 连接路径，需以 / 开头。
WS_PATH=/onebot/v11/ws
# 访问令牌；留空表示不校验。
WS_ACCESS_TOKEN=
# 是否随主服务一起自动启动 WS 服务器。
WS_AUTO_START=false
# 配置优先级：
#   file（默认）= WebUI 面板保存的 ws_config.json 覆盖本文件的默认值，面板可改可存
#   env         = 强制以 .env 为准，忽略 ws_config.json，面板「保存配置」会被拒绝
WS_CONFIG_PRIORITY=file
# 事件环形缓冲条数（WebUI 实时事件日志最多保留多少条）。
WS_EVENT_LIMIT=300
# 网页展示的单条原始 JSON 截断长度（字符）。
WS_RAW_LIMIT=4000
# 单条消息帧上限（MB），合并转发/长消息留余量。
WS_MAX_FRAME_MB=16

# ==================== Bot 指令（OneBot V11 消息指令）====================
# 指令总开关。false = 机器人不响应任何指令（/help、/meme、/pair 全部静默）。
BOT_ENABLED=true
# 机器人昵称，显示在帮助图标题与文案里。
BOT_NAME=我在哔哩学习
# 指令前缀，默认 “/”。可改成 # 等，例如 BOT_PREFIX=#
BOT_PREFIX=/
# 群聊里是否必须 @机器人 才响应指令。false = 直接发 /help 就回。
BOT_GROUP_NEED_AT=false
# 是否允许私聊使用指令。
BOT_ALLOW_PRIVATE=true
# /meme list 素材列表每页条数（超出会自动分多张图发送）。
BOT_MEME_LIST_PAGE=12
# 单张回图体积上限（MB）。GIF 表情过大时会压缩或放弃，避免撑爆 WS 单帧上限。
BOT_MAX_IMAGE_MB=8
# 同一个用户两次指令之间的最短间隔（秒），0 = 不限制。用于防刷屏。
BOT_COOLDOWN_SEC=3
# 帮助图落款文字（留空则不显示）。
BOT_FOOTER=我在哔哩学习 Emoji Bot · ILBB

# ==================== 名言图（/quote）====================
# /quote 指令开关。false = 不生成名言图，只回提示图。
QUOTE_ENABLED=true
# 名言图画布尺寸（像素）。横屏 16:9：左侧独立圆角头像 + 右半边白色磨砂玻璃面板。
QUOTE_WIDTH=1280
QUOTE_HEIGHT=720
# 背景上那层「灰色蒙版」的不透明度，0~1。
# 0.35 = 压 35% 灰，背景仍能辨认；调大背景更暗。玻璃面板 / 头像 / 文字都在蒙版之上。
QUOTE_MASK_ALPHA=0.35
# 静态图（JPG）输出质量（60~100）；内容是动图时输出 GIF，不受此项影响。
QUOTE_JPG_QUALITY=92
# 左侧独立圆角头像的宽度（像素），高度约为它的 1.32 倍。
QUOTE_AVATAR=236
# 玻璃面板的高斯模糊半径（磨砂核心，越大越糊）。
QUOTE_TRAY_BLUR=30.0
# 模糊层之上叠加的暖白玻璃浓度（0.2~0.96，越大越白、越不透）。
QUOTE_TRAY_GLASS=0.58
# 面板内容区文字自动字号的上下限（像素）：从大往小试，装不下就缩。
QUOTE_TEXT_MAX=56
QUOTE_TEXT_MIN=22
# 面板内容区最大高度（像素），超过则继续缩字号，到底线就截断加省略号。
QUOTE_MAX_BODY=500
# 右下角署名「—— 用户名」的字号（字体跟随全局 FONT_FAMILY）。
QUOTE_NAME_SIZE=40
# 取不到昵称时的占位名字。
QUOTE_NAME=无名氏
# 署名词最大显示字数（超出截断）。
QUOTE_NAME_MAX=16
# 面板内容是动图表情包时输出 GIF：最大帧数（超出等间隔抽帧）与单帧最短时长（毫秒）。
QUOTE_GIF_MAX_FRAMES=60
QUOTE_GIF_MIN_MS=40

# ==================== 插件系统（plugins/ 一个文件夹 = 一个插件）====================
# 插件总开关。false = 不加载任何插件。
PLUGIN_ENABLED=true
# 插件根目录（相对项目根目录）。每个子文件夹就是一个插件。
PLUGIN_DIR=plugins
# Web 里修改的插件配置存放文件。
PLUGIN_CONFIG_PATH=plugins_config.json
# 热重载：开启后改动插件文件 / 增删插件目录会自动生效，无需重启。
PLUGIN_HOT_RELOAD=true
# 热重载轮询间隔（秒），最小 2。
PLUGIN_POLL_SEC=3
# 插件自带 Web 的协议。插件配置里写 web=true 时，ILBB 会探测它的端口并嵌入式显示。
PLUGIN_WEB_SCHEME=http
# 插件 Web 端口自动分配起始值（插件没写 web_port 时从这里顺延分配）。
PLUGIN_WEB_PORT_BASE=7000
# 探测插件 Web 是否就绪的超时（秒）。
PLUGIN_WEB_TIMEOUT=4
# 单个插件单条指令回图上限（MB）。
PLUGIN_MAX_IMAGE_MB=8

# ==================== 目录 / 数据文件 ====================
# 相对路径按「项目根目录」解析，也可写绝对路径（如 E:/data/cache）。
TEMP_DIR=temp
CACHE_DIR=cache
FONT_DIR=font
# 全局字体：所有机器人图片（帮助图、名言图、配对卡等）统一使用。
# system = 用系统自带中文字体；也可以填 font/ 目录下的字体名（丢进字体目录即可在下拉里选中）。
FONT_FAMILY=system
# 背景图存放目录。上传的背景图由后端 /bg/<文件名> 提供，移动目录不影响访问。
BG_DIR=static/bg
# 背景配置（类型/链接/模糊/蒙版）持久化文件。
BG_CONFIG_PATH=bg_config.json
# 管理密码哈希 + API Key 存储文件。
API_KEYS_PATH=api_keys.json
# OpenAI 兼容接口出图目录（同时映射为 /v1/files/<name>）。
OPENAI_V1_DIR=cache/v1
# 上传背景图的对外 URL 前缀（通常不用改）。
BG_URL_PREFIX=bg

# ==================== 缓存 / 画布 ====================
# 生成图片缓存保留天数。
CACHE_EXPIRE_DAYS=30
# 配对卡画布尺寸（像素）。
CANVAS_WIDTH=600
CANVAS_HEIGHT=800

# ==================== 背景图 API ====================
# 随机背景图接口（登录页/工作台背景）。
BG_API_URL=https://api.yppp.net/api.php
# 背景图请求超时（秒）。
BG_FETCH_TIMEOUT=8
