# ============================================================
#  ILBB · Git 忽略规则
#  原则：可运行的最小代码 + 配置模板入库；密钥、运行时数据、
#        体积巨大的第三方素材不进仓库。
# ============================================================

# ---------- 本地私有配置（含密钥 / 管理密码，禁止提交）----------
.env
.env.local

# ---------- 运行时数据（首次启动自动生成）----------
ws_config.json
api_keys.json
bg_config.json
setup_state.json
plugins_config.json
plugins_store.json
cache/
temp/
*.log

# ---------- 用户上传的背景图（运行时数据，目录由 app.py 自动创建）----------
static/bg/custom_*

# ---------- Python 产物 ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------- 虚拟环境 / 前端依赖 ----------
.venv/
venv/
env/
node_modules/

# ---------- vendor 素材库分层 ----------
# 入库：meme 引擎源码（含 memes/<key>/__init__.py 表情定义）、字体（resources/fonts）、
#       素材清单（resource_list.json）
# 忽略：meme 图片素材本体（~254MB / 2869 文件），克隆后由引导页 /setup 联网补全
#
# memes/<key>/__init__.py 是每个表情的定义代码（add_meme 注册用），必须入库：
# 上游 resource_list.json 只列图片、不含 .py，只靠 /setup 下素材会得到一个
# 「有图片、没定义」的目录 —— 那些子目录不成其为 Python 包，引擎 pkgutil 扫描时
# 一个表情都加载不出来，表情列表于是全空。
vendor/meme-generator-main/meme_generator/memes/**/*
!vendor/meme-generator-main/meme_generator/memes/**/
!vendor/meme-generator-main/meme_generator/memes/**/__init__.py
vendor/**/__pycache__/
vendor/meme-generator-main/output/
vendor/meme-generator-main/result.*
vendor/meme-generator-main/avatar.jpg

# ---------- 本机开发遗留（截图 / 与项目无关的临时目录）----------
.shots/
qq_studio_shots/
无关文件/

# ---------- 独立仓库的插件（各自有 GitHub 仓库，不入主库）----------
# status（戳一戳状态图）与 TUFILBBhelper（TUF 论坛助手）各自独立建仓：
#   https://github.com/DXBbyd/ilbb_plugin_PockStstus
#   https://github.com/DXBbyd/ilbb_plugin_TUFILBBhelper
# BiliPlay_ILBB_Toys（36MB，含 .venv 与 data/biliplay.db）暂未单独建仓，同样不入库。
plugins/status/
plugins/ilbb_plugin_TUFILBBhelper/
plugins/BiliPlay_ILBB_Toys/

# ---------- AI 助手在本机留下的工作记忆（.workbuddy/memory，不入库）----------
.workbuddy/

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
.DS_Store
